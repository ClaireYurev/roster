# ---------------------------------------------------------------------------
# DEV MODE — bypasses JumpCloud OIDC for local testing
# Set to false (or delete) when using real JumpCloud credentials
# ---------------------------------------------------------------------------
AUTH_DEV_BYPASS=false
AUTH_DEV_USERNAME=admin
AUTH_DEV_PASSWORD=admin

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# JumpCloud OIDC — required when AUTH_DEV_BYPASS=false
# ---------------------------------------------------------------------------
AUTH_JUMPCLOUD_CLIENT_ID=""
AUTH_JUMPCLOUD_CLIENT_SECRET=""
AUTH_JUMPCLOUD_ISSUER="https://oauth.id.jumpcloud.com/"

# SQLite database path (relative to project root)
DATABASE_URL="./data/roster.db"

# URL of this application
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Freshservice API — used by Import > Freshservice Ticket tab
# Domain: just the subdomain e.g. "liquidiv" (not the full URL)
# API key: generate at https://{domain}.freshservice.com/profile#api-key
# ---------------------------------------------------------------------------
FRESHSERVICE_DOMAIN=""
FRESHSERVICE_API_KEY=""
